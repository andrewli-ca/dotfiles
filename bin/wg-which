#!/usr/bin/env bash
# wg-which — identify which WireGuard .conf file is loaded on the active interface
set -eu

if ! command -v wg >/dev/null 2>&1; then
  echo "wg command not found" >&2
  exit 1
fi

if [ "$(id -u)" -ne 0 ]; then
  exec sudo "$0" "$@"
fi

iface=$(wg show interfaces)
if [ -z "$iface" ]; then
  echo "No active WireGuard interface" >&2
  exit 1
fi

pubkey=$(wg show "$iface" | awk '/peer:/ {print $2; exit}')

echo "Interface: $iface"
echo "Peer key:  $pubkey"
echo "---"

if [ -z "$pubkey" ]; then
  echo "No peer found on $iface" >&2
  exit 1
fi

match=$(grep -rl "$pubkey" \
  /opt/homebrew/etc/wireguard/ \
  /usr/local/etc/wireguard/ \
  /etc/wireguard/ 2>/dev/null || true)

if [ -z "$match" ]; then
  echo "No matching .conf file found in standard locations."
  exit 1
fi

echo "$match"
