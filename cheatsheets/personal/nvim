# split right side by side (LazyVim)
Space |

# split below stacked (LazyVim)
Space -

# horizontal split stacked
Ctrl-w s

# vertical split side by side
Ctrl-w v

# horizontal split and open file
:sp filename

# vertical split and open file
:vs filename

# equalize all split sizes
Ctrl-w =

# zoom current split to full screen and back
Space wm

# resize current split
Ctrl-Up/Down/Left/Right

# maximize current split height
Ctrl-w _

# maximize current split width
Ctrl-w |

# move split to edge
Ctrl-w H/J/K/L

# close current split (buffer stays open)
Space wd or Ctrl-w q or :q

# close all splits except current
:only

# move left neovim split or tmux pane
Ctrl-h

# move down neovim split or tmux pane
Ctrl-j

# move up neovim split or tmux pane
Ctrl-k

# move right neovim split or tmux pane
Ctrl-l

# cycle through splits
Ctrl-w w

# pick from open buffers
Space ,

# jump back to previous file
Space `

# recent files
Space fr

# find files by filename (project root)
Space Space or Space ff

# find files by filename (cwd)
Space fF

# find files by filename (current file's folder)
Space f.

# find git tracked files (includes tracked dotfiles)
Space fg

# find all files incl. hidden + git ignored (project root)
Space fa

# toggle git ignored files inside picker
Option-i

# delete current buffer
Space bd

# delete buffer and window
Space bD

# delete all other buffers
Space bo

# previous / next buffer
Shift-h / Shift-l or [b / ]b

# close current tab
:tabc

# close all tabs except current
:tabo

# next / previous tab
gt / gT

# jump to tab 3
3gt

# quit neovim entirely
:qa

# toggle file explorer (shows hidden + git ignored by default)
Space e

# toggle hidden / git ignored files in explorer
H / I

# create new file in explorer
a

# open or create a file
:e filename.ts

# create file in same dir as current file
:e %:h/newfile.ts

# search in current file forward
/pattern

# search in current file backward
?pattern

# next / previous match
n / N

# search word under cursor forward
*

# search word under cursor backward
#

# jump to next occurrence of char on line
f{char}

# jump to prev occurrence of char on line
F{char}

# repeat last f or F jump
;

# jump to just before char on line
t{char}

# fuzzy search current buffer only
Space sb

# live grep across entire project
Space / or Space sg

# live grep in cwd
Space sG

# live grep in current file's folder
Space s.

# live grep all files incl. hidden + git ignored (project root)
Space sA

# grep word under cursor (project root)
Space sw

# search lsp symbols in current file
Space ss

# send picker results to quickfix list
Ctrl-q

# go to definition
gd

# go to references
gr

# hover docs
K

# code actions
Space ca

# rename symbol
Space cr

# jump between diagnostics
[d / ]d

# change inner word
ciw

# change inside quotes
ci"

# change inside parens
ci(

# visual line select
V

# toggle comment line
gcc

# undo
u

# redo
Ctrl-r

# copy entire file contents to system clipboard
gg"+yG

# yank selection to system clipboard (normal or visual)
Space y

# yank line to system clipboard
Space Y

# paste from system clipboard after cursor (normal or visual)
Space p

# paste from system clipboard before cursor (normal or visual)
Space P

# mnemonic for yank-path mappings:
#   p = path (relative),   P = Path (absolute)    -- capital = fuller form
#   d = directory
#   f = file stem,         n = filename with ext  -- lowercase = shorter form

# copy relative file path to clipboard
Space yp

# copy absolute file path to clipboard
Space yP

# copy directory path to clipboard
Space yd

# copy file name (without extension) to clipboard
Space yf

# copy file name (with extension) to clipboard
Space yn

# open lazygit
Space gg

# --- Search & Replace (native, no plugin) ---

# search word under cursor and jump back to it (so the first match isn't skipped)
*N

# change the next match of the last search (deletes it, enters insert mode)
cgn

# repeat that same change on the next match
.

# skip the next match without changing it
n

# full rename flow: *N then cgn newtext Esc then . to replace, n to skip
*N cgn newtext Esc . . n .

# delete the next match
dgn

# yank the next match
ygn

# uppercase the next match
gUgn

# search word under cursor including substrings (* adds word boundaries, g* does not)
g*

# replace every match of last search in file (empty pattern reuses the search)
:%s//newtext/g

# same but confirm each one (y = yes, n = skip, a = all, q = quit)
:%s//newtext/gc

# replace whole word everywhere without searching first
:%s/\<oldword\>/newtext/g

# replace on current line only
:s/old/new/g

# replace inside a visual selection (type :s while selected)
:'<,'>s/old/new/g

# replace in every open buffer and write (e flag ignores no-match errors)
:bufdo %s/old/new/ge | update

# undo replacements one at a time (each . is its own undo step)
u

# project-wide search and replace with live preview (grug-far)
Space sr

# --- Spell Check ---

# jump to next misspelled word
]s

# jump to previous misspelled word
[s

# add word to dictionary (permanent)
zg

# undo add to dictionary
zug

# ignore word for this session only
zG

# mark word as wrong
zw

# show spelling suggestions
z=

# toggle spell check on/off
Space us

# toggle theme kanso light/dark (pauses macOS auto-switch)
Space uT

# resume macOS-based theme auto-switching
:ThemeAuto

# colorscheme picker (preview any installed theme)
Space uC
