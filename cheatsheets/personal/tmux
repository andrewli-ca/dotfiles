---
tags: [ tmux, terminal ]
syntax: bash
---

# create named session (from terminal)
tmux new -s myapp

# reattach to a session
tmux attach -t myapp

# list all sessions
tmux ls

# create new session from inside tmux
Ctrl-a : new -s myapp

# detach from session (keeps it running)
Ctrl-a d

# interactive session list (navigate with j/k)
Ctrl-a s

# jump to session by name
Ctrl-a g

# previous session
Ctrl-a (

# next session
Ctrl-a )

# rename current session
Ctrl-a $

# kill current session
Ctrl-a : kill-session

# create new window
Ctrl-a c

# rename current window
Ctrl-a ,

# jump to window by number
Ctrl-a 1-9

# next / previous window
Ctrl-a n / p

# kill current window
Ctrl-a &

# kill window 3
Ctrl-a : kill-window -t 3

# window menu (swap left/right, swap marked, rename, kill, new)
Ctrl-a <

# enter copy mode
Ctrl-a [

# start selection in copy mode
v

# yank to clipboard and exit copy mode
y

# exit copy mode
q

# reload tmux config
Ctrl-a r

# clear screen (plain Ctrl-l moves to the right pane)
Ctrl-a Ctrl-l

# toggle zoom current pane fullscreen (tab shows [Z] while zoomed)
Ctrl-a z

